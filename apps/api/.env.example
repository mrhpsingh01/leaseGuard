# ---- LeaseGuard API (all optional: the app runs with zero configuration) ----

# Comma-separated browser origins allowed to call the API. "*" wildcards are supported per-label.
# Default: http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
# Production: add your Vercel production domain, e.g. https://leaseguard.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app

# Optional PostgreSQL + pgvector (e.g. Neon, Supabase, Railway Postgres, `docker compose up db`).
# Unset or unreachable => automatic SQLite + in-memory BM25/vector fallback ("local_fallback" in /api/v1/health).
# DATABASE_URL=postgresql://leaseguard:leaseguard_secret@localhost:5432/leaseguard

# Where the local fallback keeps its SQLite file (default: system temp dir).
# SQLITE_PATH=/tmp/leaseguard_local.sqlite3

# Directory holding athens_student_lease_sample.pdf + georgia_statutes.json (set by the Dockerfile).
# SAMPLE_DATA_DIR=./packages/sample-data

# Max accepted PDF upload size in MB (default 10).
# MAX_UPLOAD_MB=10

# Listen port. Render/Railway inject PORT automatically.
# PORT=8000
